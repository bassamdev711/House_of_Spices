generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  brand          String?
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  sku            String?
  size           String?
  gender         String?
  category       String?
  collectionId   String?
  collection     Collection? @relation(fields: [collectionId], references: [id])
  stock          Int      @default(0)
  featured       Boolean  @default(false)
  bestseller     Boolean  @default(false)
  isActive       Boolean  @default(true)
  imageUrl       String?
  images         String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String?     @unique
  customerName    String
  customerPhone   String
  governorate     String
  city            String
  address         String
  paymentMethod   String
  paymentStatus   String      @default("PENDING") // PENDING, AWAITING_CONFIRMATION, PAID, FAILED
  status          String      @default("NEW") // NEW, PROCESSING, SHIPPED, COMPLETED, CANCELLED
  totalAmount     Decimal     @db.Decimal(10, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 2)
  paymentProofUrl String?
  transactionId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSettings {
  id                     String   @id @default("singleton")
  bankTransferEnabled    Boolean  @default(true)
  bankTransferInstructions String?
  walletsEnabled         Boolean  @default(true)
  walletsInstructions    String?
  codEnabled             Boolean  @default(false)
  codFee                 Decimal  @db.Decimal(10, 2) @default(0)
  codInstructions        String?
  updatedAt              DateTime @updatedAt
}

model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountName   String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DigitalWallet {
  id            String   @id @default(cuid())
  walletName    String
  accountNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model StoreSettings {
  id                    String   @id @default("singleton")
  shippingFee           Decimal  @default(0) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt
}

model LegalPage {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── نظام التسويق ───────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique          // كود الكوبون (مثل: SUMMER20)
  description    String?                   // وصف اختياري للمدير
  type           String                    // PERCENTAGE | FIXED
  value          Decimal   @db.Decimal(10, 2) // قيمة الخصم
  minOrderAmount Decimal?  @db.Decimal(10, 2) // حد أدنى للطلب
  maxUses        Int?                      // حد أقصى للاستخدام (null = غير محدود)
  usedCount      Int       @default(0)    // عدد مرات الاستخدام الفعلية
  expiresAt      DateTime?               // تاريخ الانتهاء (null = لا ينتهي)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Campaign {
  id          String    @id @default(cuid())
  title       String                    // عنوان الحملة
  description String?                  // وصف/رسالة الحملة
  imageUrl    String?                  // صورة البانر (اختيارية)
  couponCode  String?                  // كود كوبون مرتبط بالحملة
  startDate   DateTime                 // تاريخ البداية
  endDate     DateTime                 // تاريخ الانتهاء
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AnnouncementBar {
  id        String   @id @default("singleton")
  message   String                           // نص الإعلان
  linkText  String?                          // نص الرابط (اختياري)
  linkUrl   String?                          // الرابط (اختياري)
  bgColor   String   @default("#1a544a")    // لون الخلفية
  textColor String   @default("#ffffff")     // لون النص
  isActive  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

